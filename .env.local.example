# GoodsMandi - Environment Variables
# Copy this file to .env.local and fill in your Supabase credentials

# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Cloudflare Turnstile site key (the public one) for bot protection on sign-up,
# log in and password reset. Leave empty to turn the check off. See SETUP.md, "Bot protection".
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
